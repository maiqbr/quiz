{
  "name": "quizarena",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-11",
  "vars": {"APP_ORIGIN": "https://quiz.maiq.dev.br", "DISCORD_CLIENT_ID": "1554580144902119444"},
